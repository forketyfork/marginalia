{
  "name": "marginalia",
  "version": "0.1.0",
  "description": "Local reader and annotator for Claude Code, Codex, and Gemini CLI session transcripts",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "bun --hot src/server/main.ts",
    "start": "NODE_ENV=production bun src/server/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "bun run typecheck && bun run lint && bun test"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
